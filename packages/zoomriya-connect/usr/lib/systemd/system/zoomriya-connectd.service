# ZOOMRIYA Connect on the box (zoomriya-connect's docs): connectd. UDP 443
# from anywhere, which it turns away unless the device is on the box's own
# list. Box Desktop switches it on; until then it waits, using nothing.
[Unit]
Description=ZOOMRIYA Connect (reaching the box from away from home)
Documentation=https://github.com/zoomriya/zoomriya-connect
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=zoomriya-connect
# Its socket's group: box-desktopd is in it, nobody else.
Group=zoomriya-connect-api
ExecStart=/usr/lib/zoomriya-connect/zoomriya-connectd run --config /etc/zoomriya-connect/connectd.toml
Restart=always
RestartSec=10
# Box Desktop's socket: the group may use it, nobody else.
RuntimeDirectory=zoomriya-connect
RuntimeDirectoryMode=0750
ReadWritePaths=/data/zoomriya-connect
# UDP 443, and nothing else a root process could do.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
