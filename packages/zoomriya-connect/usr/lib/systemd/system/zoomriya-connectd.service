# Remote access on the box (zoomriya-connect, docs/direct-plus.md): connectd.
# UDP 443 from anywhere, which it turns away unless the device is on the box's
# own list. Always on; it needs no ZOOMRIYA server and no internet. Out: the
# BitTorrent DHT (its sealed record) and Tor (its onion service, in front of
# its own iroh relay on 127.0.0.1). Tor's state is in /data/zoomriya-connect.
[Unit]
Description=Remote access (paired phones and laptops reaching the box)
Documentation=https://github.com/zoomriya/zoomriya-connect
After=network-online.target
Wants=network-online.target

[Service]
User=zoomriya-connect
# Its socket's group: box-desktopd is in it, nobody else.
Group=zoomriya-connect-api
# Opens the web servers' sockets for paired laptops (/run/zoomriya-link).
SupplementaryGroups=zoomriya-link
ExecStart=/usr/lib/zoomriya-connect/zoomriya-connectd run --config /etc/zoomriya-connect/connectd.toml
Restart=always
RestartSec=10
# Box Desktop's socket: the group may use it, nobody else.
RuntimeDirectory=zoomriya-connect
RuntimeDirectoryMode=0750
ReadWritePaths=/data/zoomriya-connect
# UDP 443, and nothing else a root process could do.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
