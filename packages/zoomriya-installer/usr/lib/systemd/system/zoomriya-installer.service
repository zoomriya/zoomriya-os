# The USB installer on the computer's screen (design §10): sway shows the
# installer full screen on tty1. It runs as root: it writes the chosen drive.
[Unit]
Description=ZOOMRIYA OS installer, on the screen
Documentation=https://github.com/zoomriya/zoomriya-os/blob/main/docs/design.md#10-building-and-testing
After=systemd-user-sessions.service systemd-udev-settle.service

[Service]
PAMName=zoomriya-installer
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=zoomriya-installer
RuntimeDirectoryPreserve=yes
WorkingDirectory=/usr/lib/zoomriya-installer
# sway as root needs its own runtime directory; the seat session gives none.
Environment=XDG_RUNTIME_DIR=/run/zoomriya-installer
# Drawn in software: any screen works, with or without a graphics driver.
Environment=WLR_RENDERER=pixman GSK_RENDERER=cairo PYTHONPATH=/usr/lib/zoomriya-installer
ExecStart=/usr/lib/zoomriya-installer/screen-session /usr/bin/python3 -m zoomriya_installer
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
