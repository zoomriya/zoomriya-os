#!/bin/sh
# Move Debian's os-release, login banners and message of the day aside, so
# base-files updates land there and not on ours (design §9). postinst writes
# ours. 10-uname (the kernel line after login) is put aside with nothing in its
# place: run-parts skips names with a dot, so it no longer runs.
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for f in /usr/lib/os-release /etc/issue /etc/issue.net /etc/motd /etc/update-motd.d/10-uname; do
        dpkg-divert --package zoomriya-base --add --rename --divert "$f.debian" "$f"
    done
fi
