// Only Debian's security archive installs by itself (design §6.1). Point
// releases and everything else wait for an image or a box upgrade we've tested.
// This replaces the list in Debian's 50unattended-upgrades.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
  "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::MinimalSteps "true";
// The agent restarts the box in the maintenance hour when a fix needs it.
Unattended-Upgrade::Automatic-Reboot "false";
