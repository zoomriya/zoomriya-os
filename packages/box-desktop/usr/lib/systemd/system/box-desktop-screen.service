# The box's own screen (box-desktop.md §6, design §5): sway shows
# box-desktop-screen full screen on tty1, the page from box-desktopd's screen
# side: the first setup until the box is set up, then Box Desktop, where
# admins sign in with ZOOMRIYA ID. tty1 is always its own.
[Unit]
Description=ZOOMRIYA Box's own screen
After=systemd-user-sessions.service systemd-tmpfiles-setup.service box-desktop.service zoomriya-hostname.service
Wants=box-desktop.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=box-desktop
PAMName=box-desktop-screen
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
StateDirectory=box-desktop
WorkingDirectory=/usr/lib/box-desktop
# Drawn in software, so any screen works, with or without a graphics driver.
Environment=WLR_RENDERER=pixman GSK_RENDERER=cairo
ExecStart=/usr/lib/box-desktop/screen-session /usr/bin/python3 /usr/lib/box-desktop/box-desktop-screen
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
