{
	"name": "box-desktop-web",
	"private": true,
	"description": "Box Desktop's page (box-desktop.md \u00a76): built into box-desktopd",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/words.mjs && vite build && node -e \"require('fs').writeFileSync('../src/dist/.keep', '')\"",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"build:installer": "vite build --config vite.installer.config.ts && node scripts/words.mjs ../../zoomriya-installer/po dist-installer/words"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tsconfig/svelte": "5.0.4",
		"@types/node": "22.19.1",
		"qrcode-generator": "2.0.4",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"vitest": "5.0.0"
	}
}
