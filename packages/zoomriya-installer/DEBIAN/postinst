#!/bin/sh
set -e

if [ "$1" = configure ]; then
    systemd-sysusers zoomriya-installer.conf
    deb-systemd-helper enable zoomriya-installer.service zoomriya-installer-screen.service >/dev/null || true
    # Only to see whether the internet is there (80-zoomriya-installer.network).
    deb-systemd-helper enable systemd-networkd.service systemd-resolved.service >/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
fi
