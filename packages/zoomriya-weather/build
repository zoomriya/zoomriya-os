#!/bin/sh
# Build the box's weather service into the package tree given as $1
# (scripts/build-packages.sh): zoomriya-weatherd, and the towns people choose
# from in the first setup and Control Panel (weather.md W-1).
#
# The towns: GeoNames' cities1000 (every place over 1,000 people) and its
# admin1 codes, cut down to the id, name, province or state, country,
# coordinates, population and time zone, by country and bigger towns first,
# in /usr/share/zoomriya/towns.tsv.gz. CC BY 4.0: "Place names from GeoNames
# (CC BY 4.0)."
#
# Each European town also gets the MeteoAlarm areas it lies in (their
# EMMA_ID codes, worked out here from MeteoAlarm's published areas), so the
# box keeps the warnings for those areas (weather.md W-4). Only the codes are
# shipped, never the shapes. CC BY 4.0, EUMETNET – MeteoAlarm.
#
# Both are read from build/geonames and build/meteoalarm, which
# scripts/download-towns.sh fills before a release: this build never
# downloads anything. ZOOMRIYA_GEONAMES and ZOOMRIYA_METEOALARM may name
# other folders holding the same files.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$1"
set -- "$(cd "$1" && pwd)"
root=$(cd "$here/../.." && pwd)
geo=${ZOOMRIYA_GEONAMES:-$root/build/geonames}

alarm=${ZOOMRIYA_METEOALARM:-$root/build/meteoalarm}
for needed in "$geo/cities1000.zip" "$geo/admin1CodesASCII.txt" "$alarm/geocodes.json"; do
    if [ ! -f "$needed" ]; then
        echo "zoomriya-weather: $needed is missing; run scripts/download-towns.sh first" >&2
        exit 1
    fi
done

share="$1/usr/share/zoomriya"
doc="$1/usr/share/doc/zoomriya-weather"
mkdir -p "$share" "$doc"
python3 -I - "$geo" "$share/towns.tsv.gz" "$alarm/geocodes.json" <<'PY'
import csv, gzip, io, json, sys, zipfile
geo, out, geocodes = sys.argv[1:]

# MeteoAlarm's areas, by country: each one's code, bounding box and rings.
areas = {}
for f in json.load(open(geocodes, encoding="utf-8"))["features"]:
    p, g = f["properties"], f["geometry"]
    polys = g["coordinates"] if g["type"] == "MultiPolygon" else [g["coordinates"]]
    xs = [pt[0] for poly in polys for pt in poly[0]]
    ys = [pt[1] for poly in polys for pt in poly[0]]
    areas.setdefault(p["country"], []).append((p["code"], min(xs), min(ys), max(xs), max(ys), polys))
if sum(len(v) for v in areas.values()) < 1000:
    raise SystemExit("MeteoAlarm's geocodes look cut short")

def in_ring(ring, x, y):
    inside = False
    j = len(ring) - 1
    for i in range(len(ring)):
        xi, yi = ring[i][0], ring[i][1]
        xj, yj = ring[j][0], ring[j][1]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside

def area_codes(country, lat, lon):
    found = []
    for code, x0, y0, x1, y1, polys in areas.get(country, ()):
        if x0 <= lon <= x1 and y0 <= lat <= y1:
            for poly in polys:
                if in_ring(poly[0], lon, lat) and not any(in_ring(h, lon, lat) for h in poly[1:]):
                    found.append(code)
                    break
    return ",".join(found)
admin1 = {}
with open(f"{geo}/admin1CodesASCII.txt", encoding="utf-8") as f:
    for line in f:
        code, name, *_ = line.rstrip("\n").split("\t")
        admin1[code] = name
rows = []
with zipfile.ZipFile(f"{geo}/cities1000.zip") as z, z.open("cities1000.txt") as raw:
    for r in csv.reader(io.TextIOWrapper(raw, encoding="utf-8"), delimiter="\t", quoting=csv.QUOTE_NONE):
        gid, name, ascii_, _alt, lat, lon, _fc, _fcode, country, _cc2, a1 = r[:11]
        population, tz = r[14], r[17]
        if not (gid.isdigit() and len(country) == 2 and name and "\t" not in name):
            continue
        rows.append((country, -int(population or 0), name, gid, ascii_, admin1.get(f"{country}.{a1}", ""),
                     f"{float(lat):.4f}", f"{float(lon):.4f}", tz, area_codes(country, float(lat), float(lon))))
if len(rows) < 100000:
    raise SystemExit(f"GeoNames' towns look cut short: {len(rows)}")
rows.sort()
with gzip.open(out, "wt", encoding="utf-8", compresslevel=9) as f:
    f.write("# id\tname\tascii\tcountry\tadmin1\tlat\tlon\tpopulation\ttimezone\tmeteoalarm\n")
    for country, pop, name, gid, ascii_, a1, lat, lon, tz, codes in rows:
        f.write(f"{gid}\t{name}\t{ascii_}\t{country}\t{a1}\t{lat}\t{lon}\t{-pop}\t{tz}\t{codes}\n")
PY
{
    echo "Place names from GeoNames (https://www.geonames.org), CC BY 4.0:"
    echo "https://creativecommons.org/licenses/by/4.0/"
    echo "cities1000 and admin1CodesASCII, downloaded $(cat "$geo/downloaded" 2>/dev/null || echo 'before the build')."
    echo
    echo "Each European town's MeteoAlarm area codes (EMMA_ID), worked out from"
    echo "EUMETNET – MeteoAlarm's $(cat "$alarm/source" 2>/dev/null || echo 'geocodes'), CC BY 4.0 (meteoalarm.org)."
} > "$doc/geonames.txt"

lib="$1/usr/lib/zoomriya-weather"
mkdir -p "$lib"
version=$(sed -n 's/^Version: //p' "$here/DEBIAN/control")
cd "$here/src"
CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off go test ./...
CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off \
    go build -trimpath -ldflags="-s -w -X main.version=$version" -o "$lib/zoomriya-weatherd" .
