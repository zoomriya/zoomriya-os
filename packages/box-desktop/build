#!/bin/sh
# Build Box Desktop into the package tree given as $1 (scripts/build-packages.sh):
# the page (web/, with Vite) into src/dist, then box-desktopd with it built in.
# A static binary: it needs nothing from the box but the kernel.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
# The page: its types and its own tests first, then built.
(cd "$here/web" && npm ci --no-audit --no-fund && npm run check && npm test && npm run build)
mkdir -p "$1/usr/lib/box-desktop"
cd "$here/src"
CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off go test ./...
CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off \
    go build -trimpath -ldflags='-s -w' -o "$1/usr/lib/box-desktop/box-desktopd" .
