#!/bin/sh
# Give Debian its os-release, login banners, message of the day and sleep back.
set -e

if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = abort-install ]; then
    rm -f /usr/lib/os-release /etc/issue /etc/issue.net /etc/motd
    for f in /usr/lib/os-release /etc/issue /etc/issue.net /etc/motd /etc/update-motd.d/10-uname; do
        dpkg-divert --package zoomriya-base --remove --rename --divert "$f.debian" "$f"
    done
    # Sleep allowed again, as Debian has it.
    systemctl unmask --quiet sleep.target suspend.target hibernate.target hybrid-sleep.target \
        suspend-then-hibernate.target 2>/dev/null || true
fi
