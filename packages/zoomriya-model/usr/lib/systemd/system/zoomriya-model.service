# The box's model service (box-desktop.md §4, Myira): one language model in
# memory, in llama.cpp's llama-server, answering Box Desktop's Myira and the
# ZOOMRIYA apps on its socket (/run/zoomriya/model.sock, zoomriya-model.socket).
# Its llama-server listens on a socket in this service's own runtime folder
# (/run/zoomriya-model, 0700) behind a key only this service knows. No TCP
# port at all.
[Unit]
Description=ZOOMRIYA model service (the box's language model)
Documentation=https://github.com/zoomriya/zoomriya-os/blob/main/docs/box-desktop.md
Requires=zoomriya-model.socket
After=zoomriya-model.socket zoomriya-id.socket
Wants=zoomriya-id.socket
# The apps' own model service, from before: the same address.
Conflicts=zoomriya-myira.service

[Service]
User=zoomriya-model
Group=zoomriya-model
ExecStart=/usr/lib/zoomriya-model/zoomriya-modeld
# The admin's model choice.
StateDirectory=zoomriya-model
StateDirectoryMode=0700
# llama-server's socket: this account's alone.
RuntimeDirectory=zoomriya-model
RuntimeDirectoryMode=0700
Restart=always
RestartSec=3
TimeoutStopSec=30
# The model takes about its file size in memory, and its vision file more.
MemoryMax=8G
# The box's other work goes first.
Nice=5
# Offline, always: no network at all. It reaches only ZOOMRIYA ID's socket,
# for its keys, and llama-server's.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=-/data/models
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
