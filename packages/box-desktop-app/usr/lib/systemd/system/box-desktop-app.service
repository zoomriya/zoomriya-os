# Box Desktop on the box's own screen (box-desktop.md): sway shows it full
# screen on tty1 once the box is set up; admins sign in with ZOOMRIYA ID.
[Unit]
Description=Box Desktop, on the box's screen
After=systemd-user-sessions.service zoomriya-agent.socket zoomriya-id.service zoomriya-setup.service
Wants=zoomriya-id.service
ConditionPathExists=/var/lib/zoomriya-os/setup-done

[Service]
User=box-desktop-app
PAMName=box-desktop-app
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
StateDirectory=box-desktop-app
WorkingDirectory=/usr/lib/box-desktop-app
# Drawn in software: any screen works, with or without a graphics driver.
Environment=WLR_RENDERER=pixman GSK_RENDERER=cairo PYTHONPATH=/usr/lib/box-desktop-app:/usr/lib/zoomriya-setup
ExecStart=/usr/lib/zoomriya-setup/screen-session /usr/bin/python3 -m box_desktop
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
