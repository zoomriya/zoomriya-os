[Unit]
Description=Make the baseline of the OS's files (AIDE)
Documentation=https://github.com/zoomriya/zoomriya-os/blob/main/docs/design.md#8-hardening
After=local-fs.target
ConditionPathExists=!/var/lib/zoomriya-aide/aide.db.gz

[Service]
Type=oneshot
ExecStart=/usr/lib/zoomriya-base/aide-baseline
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
