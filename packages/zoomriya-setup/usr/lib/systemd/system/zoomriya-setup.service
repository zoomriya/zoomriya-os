# The first setup on the box's own screen (design §5): sway shows the setup
# app full screen on tty1 until the box is set up. Finish marks it set up and
# hands tty1 to Box Desktop (box-desktop-app.service), or to the login prompt
# where Box Desktop isn't installed.
[Unit]
Description=ZOOMRIYA Box first setup, on the box's screen
Documentation=https://github.com/zoomriya/zoomriya-os/blob/main/docs/design.md#5-first-boot
After=systemd-user-sessions.service zoomriya-agent.socket zoomriya-id.service
Wants=zoomriya-id.service
ConditionPathExists=!/var/lib/zoomriya-os/setup-done

[Service]
User=zoomriya-setup
PAMName=zoomriya-setup
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
StateDirectory=zoomriya-setup
WorkingDirectory=/usr/lib/zoomriya-setup
# Drawn in software: any screen works, with or without a graphics driver.
Environment=WLR_RENDERER=pixman GSK_RENDERER=cairo PYTHONPATH=/usr/lib/zoomriya-setup
ExecStart=/usr/lib/zoomriya-setup/screen-session /usr/bin/python3 -m zoomriya_setup
ExecStopPost=-+/bin/systemctl --no-block start box-desktop-app.service
ExecStopPost=-+/bin/systemctl --no-block start getty@tty1.service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
