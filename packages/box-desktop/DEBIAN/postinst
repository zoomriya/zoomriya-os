#!/bin/sh
set -e

if [ "$1" = configure ]; then
    systemd-sysusers box-desktop.conf
    # Each admin's settings, kept by the native desktop's account before.
    if [ -d /data/zoomriya/admin ]; then
        chown -R box-desktop:box-desktop /data/zoomriya/admin
    fi
    systemd-tmpfiles --create box-desktop.conf || true
    # The box's own name for its own screen (box-desktop-screen), as
    # zoomriya-base's set-hostname writes it on a new box.
    name=$(cat /etc/hostname 2>/dev/null || true)
    if [ -n "$name" ] && ! grep -q "[[:space:]]$name.local\b" /etc/hosts 2>/dev/null; then
        printf '127.0.0.1\t%s.local\t# the box'"'"'s own screen (Box Desktop)\n' "$name" >> /etc/hosts
    fi
    deb-systemd-helper enable box-desktop.service >/dev/null || true
    deb-systemd-helper enable box-desktop-screen.service >/dev/null || true
    # The sound server, in the screen's own session.
    systemctl --global enable pipewire.socket wireplumber.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        deb-systemd-invoke restart box-desktop.service >/dev/null || true
        deb-systemd-invoke restart box-desktop-screen.service >/dev/null || true
    fi
fi
