#!/bin/sh
# Make the OS what it was at restore point NUMBER (design §6.1). Takes a
# restore point of the OS as it is now first, so this can be undone too. The
# current @ is kept as @.replaced-<time> until the next start removes it
# (zoomriya-restore-cleanup.service); the restored OS runs from the next start.
# Boot entries for kernels the restored OS doesn't have are removed, so the box
# can't start a kernel without its modules. Never touches /data, the databases
# or the app images: they aren't in @.
#
# With --erase-everything (Erase everything, design §4), the restored OS also
# carries a flag: at its first start, before anything mounts them, erase
# empties the family's data, the databases, the app images and the logs.
# Usage: restore-snapshot [--erase-everything] NUMBER
set -eu

erase=no
if [ "${1:-}" = --erase-everything ]; then
    erase=yes
    shift
fi
number=${1:?usage: restore-snapshot [--erase-everything] NUMBER}
case "$number" in *[!0-9]*) echo "Not a restore point number: $number" >&2; exit 2 ;; esac
source=/.snapshots/$number/snapshot
[ -d "$source" ] || { echo "No restore point $number." >&2; exit 1; }

snapper -c root create --cleanup-algorithm number --description "Before restoring $number"

top=/run/zoomriya-base/top
mkdir -p "$top"
mountpoint -q "$top" || mount -o subvolid=5 /dev/disk/by-partlabel/system "$top"
trap 'umount "$top"' EXIT

replaced="@.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
mv "$top/@" "$top/$replaced"
if ! btrfs -q subvolume snapshot "$source" "$top/@"; then
    mv "$top/$replaced" "$top/@"
    echo "Couldn't restore $number; nothing was changed." >&2
    exit 1
fi
if [ "$erase" = yes ]; then
    mkdir -p "$top/@/var/lib/zoomriya-base"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$top/@/var/lib/zoomriya-base/erase-pending"
fi

# Boot entries for kernels the restored OS doesn't have.
esp=$(bootctl --print-esp-path)
for entry in "$esp"/loader/entries/*.conf; do
    [ -f "$entry" ] || continue
    version=$(sed -n 's/^version *//p' "$entry")
    [ -n "$version" ] && [ ! -d "$top/@/usr/lib/modules/$version" ] || continue
    for file in $(sed -n 's/^\(linux\|initrd\) *//p' "$entry"); do
        rm -f "$esp/${file#/}"
    done
    rm -f "$entry"
    rmdir "$esp"/*/"$version" 2>/dev/null || true
done

echo "Restored $number. Restart the box to finish."
